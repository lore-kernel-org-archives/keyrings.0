On Wed, 2018-10-17 at 15:15 +0100, Mark J Cox wrote:
> Allow sign-file to use any available OpenSSL engine for signing
> by specifying the "-e engine" option.

That's less egregiously wrong; thanks :)

But it's still not great. What engine are you actually trying to use
here? Can't you make it Just Work without the user having to get
involved in knowing the details of the crypto library you happen to be
using today? Recognise its storage file format if it has one (like the
TPM engine has distinctive PEM tags), or use STORE, or recognise its
URI format if it has one (like RFC7512 for PKCS#11, or Nikos's draft
for tpmkey: at least for TPMv1.2).



> Signed-off-by: Mark J Cox <mjc@redhat.com>
>=20
> --- sign-file.c-orig	2018-10-17 14:56:38.219217362 +0100
> +++ sign-file.c	2018-10-17 15:13:28.723031723 +0100
> @@ -70,7 +70,7 @@ static __attribute__((noreturn))
>   void format(void)
>   {
>   	fprintf(stderr,
> -		"Usage: scripts/sign-file [-dp] <hash algo> <key> <x509> <module> [<de=
st>]\n");
> +		"Usage: scripts/sign-file [-dp] [-e engine] <hash algo> <key> <x509> <=
module> [<dest>]\n");
>   	fprintf(stderr,
>   		"       scripts/sign-file -s <raw sig> <hash algo> <x509> <module> [<=
dest>]\n");
>   	exit(2);
> @@ -132,17 +132,20 @@ static int pem_pw_cb(char *buf, int len,
>   	return pwlen;
>   }
>=20
> -static EVP_PKEY *read_private_key(const char *private_key_name)
> +static EVP_PKEY *read_private_key(char *engine_name, const char *private=
_key_name)
>   {
>   	EVP_PKEY *private_key;
>=20
>   	if (!strncmp(private_key_name, "pkcs11:", 7)) {
> +	    engine_name =3D "pkcs11";
> +	}
> +	if (engine_name) {
>   		ENGINE *e;
>=20
>   		ENGINE_load_builtin_engines();
>   		drain_openssl_errors();
> -		e =3D ENGINE_by_id("pkcs11");
> -		ERR(!e, "Load PKCS#11 ENGINE");
> +		e =3D ENGINE_by_id(engine_name);
> +		ERR(!e, "Load %s ENGINE", engine_name);
>   		if (ENGINE_init(e))
>   			drain_openssl_errors();
>   		else
> @@ -210,7 +213,7 @@ int main(int argc, char **argv)
>   {
>   	struct module_signature sig_info =3D { .id_type =3D PKEY_ID_PKCS7 };
>   	char *hash_algo =3D NULL;
> -	char *private_key_name =3D NULL, *raw_sig_name =3D NULL;
> +	char *private_key_name =3D NULL, *raw_sig_name =3D NULL, *engine_name =
=3D NULL;
>   	char *x509_name, *module_name, *dest_name;
>   	bool save_sig =3D false, replace_orig;
>   	bool sign_only =3D false;
> @@ -242,7 +245,7 @@ int main(int argc, char **argv)
>   #endif
>=20
>   	do {
> -		opt =3D getopt(argc, argv, "sdpk");
> +		opt =3D getopt(argc, argv, "sdpke:");
>   		switch (opt) {
>   		case 's': raw_sig =3D true; break;
>   		case 'p': save_sig =3D true; break;
> @@ -250,6 +253,7 @@ int main(int argc, char **argv)
>   #ifndef USE_PKCS7
>   		case 'k': use_keyid =3D CMS_USE_KEYID; break;
>   #endif
> +		case 'e': engine_name =3D optarg; break;
>   		case -1: break;
>   		default: format();
>   		}
> @@ -294,7 +298,7 @@ int main(int argc, char **argv)
>   		/* Read the private key and the X.509 cert the PKCS#7 message
>   		 * will point to.
>   		 */
> -		private_key =3D read_private_key(private_key_name);
> +		private_key =3D read_private_key(engine_name, private_key_name);
>   		x509 =3D read_x509(x509_name);
>=20
>   		/* Digest the module data. */


